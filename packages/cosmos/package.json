{
	"name": "@foretag/cosmos",
	"version": "0.1.0",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./styles.css": "./src/styles/app.css",
		"./themes": {
			"types": "./src/lib/theme.ts",
			"import": "./src/lib/theme.ts"
		}
	},
	"files": [
		"src",
		"public",
		"dist"
	],
	"scripts": {
		"build": "bunx tsc -p tsconfig.build.json",
		"typecheck": "bunx tsc --noEmit",
		"test": "bunx vitest run --config vitest.config.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --output-dir ${STORYBOOK_OUTPUT_DIR:-./storybook-static}"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@tabler/icons-webfont": "^3.41.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react-day-picker": "^9.14.0",
		"react-hook-form": "^7.66.0",
		"react-resizable-panels": "^4.10.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@storybook/addon-essentials": "^8.6.14",
		"@storybook/react": "^8.6.14",
		"@storybook/react-vite": "^8.6.14",
		"@storybook/test": "^8.6.14",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.13",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.0.1",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitejs/plugin-react": "^5.0.4",
		"jsdom": "^25.0.1",
		"storybook": "^8.6.14",
		"tailwindcss": "^4.1.13",
		"tw-animate-css": "^1.2.5",
		"typescript": "^5.9.3",
		"vite": "^7.1.7",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.2.4"
	}
}
