{
	"name": "cosmos",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "bun@1.3.5",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run dev:storybook",
		"dev:storybook": "bun run --cwd packages/cosmos storybook",
		"lint": "bunx biome lint .",
		"format": "bunx biome format --write .",
		"format:check": "bunx biome format .",
		"typecheck": "bun run typecheck:cosmos",
		"typecheck:cosmos": "bun run --cwd packages/cosmos typecheck",
		"test": "bun run test:unit",
		"test:unit": "bun run --cwd packages/cosmos test",
		"build:storybook": "bun run --cwd packages/cosmos build-storybook",
		"build:cosmos": "bun run --cwd packages/cosmos build",
		"build": "bun run build:cosmos && bun run build:storybook",
		"ci": "bun run lint && bun run format:check && bun run typecheck && bun run test:unit && bun run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7"
	}
}
