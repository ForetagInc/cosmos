{
	"name": "cosmos",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*",
		"storybook"
	],
	"scripts": {
		"dev": "bun run dev:storybook",
		"dev:storybook": "bun run --cwd storybook storybook",
		"lint": "bunx biome lint .",
		"format": "bunx biome format --write .",
		"format:check": "bunx biome format .",
		"typecheck": "bun run build:cosmos && bun run typecheck:cosmos && bun run typecheck:storybook",
		"typecheck:cosmos": "bun run --cwd packages/cosmos typecheck",
		"typecheck:storybook": "bun run --cwd storybook typecheck",
		"test": "bun run test:unit && bun run test:stories",
		"test:unit": "bun run --cwd packages/cosmos test",
		"test:stories": "bun run build:cosmos && bunx vitest run --project storybook",
		"build:storybook": "bun run --cwd storybook build-storybook",
		"build:storybook:cf": "bun run --cwd storybook build-storybook:cf",
		"build:cosmos": "bun run --cwd packages/cosmos build",
		"build": "bun run build:cosmos && bun run build:storybook",
		"ci": "bun run lint && bun run format:check && bun run typecheck && bun run test:unit && bun run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@happy-dom/global-registrator": "^20.11.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7"
	}
}
