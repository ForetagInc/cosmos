{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"jsx": "react-jsx",
		"resolveJsonModule": true,
		"allowJs": true,
		"verbatimModuleSyntax": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"types": ["vite/client"]
	}
}
