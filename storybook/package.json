{
	"name": "@foretag/storybook",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./styles.css": "./src/styles/app.css",
		"./themes": {
			"types": "./src/lib/theme.ts",
			"import": "./src/lib/theme.ts"
		}
	},
	"files": [
		"src",
		"public",
		"dist"
	],
	"scripts": {
		"build": "bunx tsc -p tsconfig.build.json",
		"typecheck": "bunx tsc --noEmit",
		"test": "bunx vitest run --config vitest.config.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --output-dir ${STORYBOOK_OUTPUT_DIR:-./storybook-static}"
	},
	"peerDependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"dependencies": {
		"@storybook/addon-themes": "^10.5.8",
		"@tabler/icons-webfont": "^3.46.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.6.7",
		"react-day-picker": "^9.14.0",
		"react-hook-form": "^7.85.0",
		"react-resizable-panels": "^4.12.2",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.5.8",
		"@storybook/addon-docs": "^10.5.8",
		"@storybook/react": "^10.5.8",
		"@storybook/react-vite": "^10.5.8",
		"@storybook/test": "^8.6.15",
		"@storybook/test-runner": "^0.24.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^5.2.0",
		"jsdom": "^25.0.1",
		"storybook": "^10.5.8",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.2.7"
	}
}
