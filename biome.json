{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always"
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/apps/design/public/storybook",
			"!**/coverage",
			"!**/playwright-report",
			"!**/test-results",
			"!**/.tanstack",
			"!**/.wrangler",
			"!**/node_modules",
			"!**/routeTree.gen.ts",
			"!**/*.css",
			"!**/*.html"
		]
	}
}
